# Kit (formerly ConvertKit) — https://app.kit.com → Settings → Developer
KIT_API_KEY=
# The numeric id of the Kit form subscribers join from this site
# ("ingaze creative website" form, id 9931864)
KIT_FORM_ID=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Where inquiry-form notifications land (defaults to theingaze@gmail.com)
INQUIRY_TO_EMAIL=theingaze@gmail.com
# Must be on a domain verified in Resend; defaults to their shared sender
INQUIRY_FROM_EMAIL=
